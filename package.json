{
  "name": "@kiligzzz/dsh-session-nav",
  "description": "Piano-key style in-conversation navigation bar for the DeepSeek Harness web GUI: one key per user message, hover ladder animation, turn-preview tooltip, active-message highlight, click-to-jump. Official dual-face dsh plugin (host + client), no dsh source changes.",
  "version": "0.1.11",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "navigation",
    "piano",
    "conversation"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7 || ^0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.8 || ^0.1.1-rc.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "cordis": "^4.0.0-rc.7 || ^4.0.0"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/shared.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "assets/"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiligzzz/dsh-session-nav.git"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.26.0",
    "prettier": "^3.5.3",
    "vitest": "^3.2.7"
  }
}
